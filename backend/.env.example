# Banco (ou defina DATABASE_URL, que tem precedência)
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Admin global criado no primeiro start (python -m app.db.seed)
ADMIN_EMAIL=admin@academiadelocacao.com.br
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administrador

# Biblioteca
NOVIDADE_DIAS=30
UPLOAD_MAX_MB=25
